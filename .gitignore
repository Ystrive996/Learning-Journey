# ===== C++ 编译产物 =====
# 可执行文件
*.exe
*.out
*.app

# 目标文件和静态/动态库
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib

# 编译产生的中间目录 (适用于你之前用的 build 目录)
build/
debug/
release/
bin/
obj/

# CMake 生成的文件
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# ===== VS Code 配置 =====
# 通常建议忽略，避免每个人的环境不同产生冲突
.vscode/*
*.json

# ===== 操作系统生成的文件 =====
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store

# Linux
*~
.Trash-*

# ===== 日志与临时文件 =====
*.log
*.tmp
*.temp
temp/
tmp/

# ===== IDE 配置（如果你以后用其他 IDE）=====
# JetBrains (CLion)
.idea/
*.iml

# Visual Studio
.vs/
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user